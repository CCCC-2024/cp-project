lab_project/data/raw/**/*.HEIC
lab_project/data/raw/**/*.heic

# midterm: everything stays local (exam PDF, original photos with name/UF ID/GPS,
# Notion snapshots, papers, handoffs, prompts) except handwritten/, which holds
# EXIF-free copies of the answer pages with name and UF ID painted out.
/midterm/*
!/midterm/handwritten/
